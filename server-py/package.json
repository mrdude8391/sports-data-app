{
  "name": "server",
  "version": "0.0.0",
  "scripts": {
    "activate": "venv\\scripts\\activate",
    "activate:mac": ". venv/bin/activate",
    "preserver": "venv\\scripts\\activate && pip install -r requirements.txt -q",
    "server": "venv\\scripts\\activate && uvicorn src.main:app --reload",
    "pretest": "docker compose -f docker-compose.test.yml up -d",
    "test": "venv\\scripts\\activate && pytest",
    "posttest": "docker compose -f docker-compose.test.yml down",
    "preserver:mac": ". venv/bin/activate && pip install -r requirements.txt -q",
    "server:mac": ". venv/bin/activate && uvicorn src.main:app --reload",
    "pretest:mac": "docker compose -f docker-compose.test.yml up -d",
    "test:mac": ". venv/bin/activate && pytest",
    "posttest:mac": "docker compose -f docker-compose.test.yml down"
  }
}
