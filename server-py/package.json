{
  "name": "server",
  "version": "0.0.0",
  "scripts": {
    "preserver": "venv\\scripts\\activate && pip install -r requirements.txt -q && echo 'Server dependencies installed'",
    "server": "venv\\scripts\\activate && uvicorn src.main:app --reload",
    "pretest": "docker compose -f docker-compose.test.yml up -d ",
    "test": "venv\\scripts\\activate && pytest",
    "posttest": "docker compose -f docker-compose.test.yml down",
    "preservermac": ". venv/bin/activate && pip install -r requirements.txt -q && echo 'Server dependencies installed'",
    "servermac": ". venv/bin/activate && uvicorn src.main:app --reload",
    "pretestmac": "docker compose -f docker-compose.test.yml up -d ",
    "testmac": ". venv/bin/activate && pytest",
    "posttestmac": "docker compose -f docker-compose.test.yml down"
  }
}
